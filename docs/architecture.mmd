flowchart TD
    subgraph ui["interfaz de usuario"]
        ui_reportante["pantallas reportante<br/>crear, listar, detalle"]
        ui_tecnico["pantallas técnico<br/>asignadas, diagnóstico"]
        ui_coordinador["pantallas coordinador<br/>priorizar, asignar, cerrar"]
    end

    subgraph application["aplicación - casos de uso"]
        uc_login["iniciar sesión"]
        uc_listincidents["listar incidencias"]
        uc_getincidentdetail["ver detalle de incidencia"]
        uc_createincident["crear incidencia"]
        uc_assignincident["asignar incidencia"]
        uc_resolveincident["resolver incidencia"]
        uc_closeincident["cerrar incidencia"]
    end

    subgraph domain["dominio - entidades y contratos"]
        e_incident["entidad: incidencia"]
        e_session["entidad: sesión"]
        c_incidentrepo[["contrato: repositorio de incidencias"]]
        c_sessionrepo[["contrato: repositorio de sesión"]]
        c_locationprovider[["contrato: proveedor de ubicación"]]
    end

    subgraph infrastructure["infraestructura - implementaciones"]
        impl_inmemory["repositorio en memoria<br/>datos ficticios - semana 2"]
        impl_backendapi["adaptador de api del backend<br/>/v1/incidents"]
        impl_geocoding["adaptador de geocodificación<br/>/v1/geocoding"]
        impl_securestore["almacenamiento seguro<br/>sesión y credenciales"]
    end

    ui_reportante --> uc_createincident
    ui_reportante --> uc_listincidents
    ui_reportante --> uc_getincidentdetail
    ui_tecnico --> uc_listincidents
    ui_tecnico --> uc_resolveincident
    ui_coordinador --> uc_assignincident
    ui_coordinador --> uc_closeincident
    ui_reportante -.-> uc_login
    ui_tecnico -.-> uc_login
    ui_coordinador -.-> uc_login

    uc_listincidents --> c_incidentrepo
    uc_getincidentdetail --> c_incidentrepo
    uc_createincident --> c_incidentrepo
    uc_assignincident --> c_incidentrepo
    uc_resolveincident --> c_incidentrepo
    uc_closeincident --> c_incidentrepo
    uc_login --> c_sessionrepo

    c_incidentrepo --> e_incident
    c_sessionrepo --> e_session

    impl_inmemory -. implementa .-> c_incidentrepo
    impl_backendapi -. implementa .-> c_incidentrepo
    impl_geocoding -. implementa .-> c_locationprovider
    impl_securestore -. implementa .-> c_sessionrepo

    classdef ui fill:#cfe8ff,stroke:#1c6fb0
    classdef application fill:#d9f2d0,stroke:#3a8f2f
    classdef domain fill:#fff3c4,stroke:#b8890a
    classdef infrastructure fill:#f6d0d0,stroke:#b02e2e

    class ui_reportante,ui_tecnico,ui_coordinador ui
    class uc_login,uc_listincidents,uc_getincidentdetail,uc_createincident,uc_assignincident,uc_resolveincident,uc_closeincident application
    class e_incident,e_session,c_incidentrepo,c_sessionrepo,c_locationprovider domain
    class impl_inmemory,impl_backendapi,impl_geocoding,impl_securestore infrastructure
